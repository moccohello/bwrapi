from collections import deque
from typing import ClassVar, Self, TypeAlias, overload

_Scalar: TypeAlias = int | float

class _PointMethods:
    x: int
    y: int
    list: ClassVar[type[deque[_PointMethods]]]
    @overload
    def __init__(self) -> None: ...
    @overload
    def __init__(self, x: _Scalar, y: _Scalar) -> None: ...
    @overload
    def __init__(self, x: _PointMethods) -> None: ...
    def __copy__(self) -> Self: ...
    def __deepcopy__(self, memo: dict[int, object]) -> Self: ...
    def __hash__(self) -> int: ...
    def __eq__(self, other: object) -> bool: ...
    def __ne__(self, other: object) -> bool: ...
    def __lt__(self, other: _PointMethods) -> bool: ...
    def __str__(self) -> str: ...
    def __repr__(self) -> str: ...
    def __bool__(self) -> bool: ...
    def __add__(self, other: _PointMethods) -> Self: ...
    def __iadd__(self, other: _PointMethods) -> Self: ...
    def __sub__(self, other: _PointMethods) -> Self: ...
    def __isub__(self, other: _PointMethods) -> Self: ...
    def __mul__(self, value: _Scalar) -> Self: ...
    def __imul__(self, value: _Scalar) -> Self: ...
    def __truediv__(self, value: _Scalar) -> Self: ...
    def __itruediv__(self, value: _Scalar) -> Self: ...
    def __mod__(self, value: _Scalar) -> Self: ...
    def __imod__(self, value: _Scalar) -> Self: ...
    def __or__(self, value: _Scalar) -> Self: ...
    def __ior__(self, value: _Scalar) -> Self: ...
    def __and__(self, value: _Scalar) -> Self: ...
    def __iand__(self, value: _Scalar) -> Self: ...
    def __xor__(self, value: _Scalar) -> Self: ...
    def __ixor__(self, value: _Scalar) -> Self: ...
    def isValid(self) -> bool: ...
    def makeValid(self) -> Self: ...
    def getDistance(self, position: _PointMethods) -> float: ...
    def getLength(self) -> float: ...
    def getApproxDistance(self, position: _PointMethods) -> int: ...
    @overload
    def setMax(self, max_x: _Scalar, max_y: _Scalar) -> Self: ...
    @overload
    def setMax(self, max_x: _PointMethods) -> Self: ...
    @overload
    def setMin(self, min_x: _Scalar, min_y: _Scalar) -> Self: ...
    @overload
    def setMin(self, min_x: _PointMethods) -> Self: ...

class Point(_PointMethods): ...
class Position(Point): ...
class WalkPosition(_PointMethods): ...
class TilePosition(_PointMethods): ...

_PointInput: TypeAlias = _PointMethods | tuple[_Scalar, _Scalar]
@overload
def _readonly_copy(value: Position) -> Position: ...
@overload
def _readonly_copy(value: WalkPosition) -> WalkPosition: ...
@overload
def _readonly_copy(value: TilePosition) -> TilePosition: ...
